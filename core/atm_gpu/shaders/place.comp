#version 450
// A picture placed anywhere on the frame (turned, cropped, with its own transparency) or a text mask in one colour: the
// renderer's draw_rotated and draw_text, one plane per dispatch and one invocation per 4-byte word of the frame. Every
// output pixel finds its picture point with the renderer's Placement arithmetic (multiplications and additions, kept
// apart with `precise`), so both give the same bytes.
//   kind 0 picture: NV12 (and an alpha plane when it has one), integer bilinear sampling clamped to the picture
//   kind 1 mask:    one byte per pixel, float bilinear sampling, nothing outside it; the colour's Y, U and V

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Source { uint src[]; };
layout(std430, set = 0, binding = 1) buffer Frame { uint frame[]; };
layout(std430, set = 0, binding = 2) readonly buffer Params { uint params[]; };

layout(push_constant) uniform Place {
  uint frame_at;  // where the plane starts in the frame (bytes)
  uint stride;    // bytes per row of the frame (a multiple of 4)
  uint x0, x1;    // the bytes of a row written: [x0, x1)
  uint y0, y1;    // the rows written
  uint chroma;    // 0: the luma plane; 1: the chroma plane (x0, x1 in bytes, two per U/V pair)
  uint at;        // where the placement's numbers start in Params
} pc;

// The placement's numbers (params[at + ...]): kind, alpha (0..256), w, h, pitch, y_at, uv_at, alpha_at (~0: none),
// cropped, colour (Y | U << 8 | V << 16), then the floats px, py, cos, sin, 1/sx, 1/sy, ax, ay, u0, v0, u1, v1, sx, sy.
uint P(uint i) { return params[pc.at + i]; }
float F(uint i) { return uintBitsToFloat(params[pc.at + 10u + i]); }

int src_byte(uint i) { return int((src[i >> 2] >> ((i & 3u) * 8u)) & 0xFFu); }

// The picture point under an output point (Placement::source).
vec2 source(float x, float y) {
  precise float dx = x - F(0u), dy = y - F(1u);
  precise float a = dx * F(2u), b = dy * F(3u), c = dy * F(2u), d = dx * F(3u);
  precise float su = a + b, sv = c - d;
  precise float u = su * F(4u) + F(6u);
  precise float v = sv * F(5u) + F(7u);
  return vec2(u, v);
}

// How much of the visible picture covers a picture point, 0..1 (Placement::coverage).
float edge(vec2 p) {
  precise float cx = min(p.x - F(8u), F(10u) - p.x) * F(12u) + 0.5;
  precise float cy = min(p.y - F(9u), F(11u) - p.y) * F(13u) + 0.5;
  precise float e = clamp(cx, 0.0, 1.0) * clamp(cy, 0.0, 1.0);
  return e;
}

// The renderer's `sample`: integer bilinear, at a sample-centred position, clamped to the plane.
int sample_plane(uint at, uint pitch, int w, int h, int channels, int k, float x, float y) {
  x = clamp(x, 0.0, float(w - 1));
  y = clamp(y, 0.0, float(h - 1));
  const int x0 = int(x), y0 = int(y), x1 = min(x0 + 1, w - 1), y1 = min(y0 + 1, h - 1);
  precise float fx = (x - float(x0)) * 256.0, fy = (y - float(y0)) * 256.0;
  const int wx = int(fx), wy = int(fy);
  const uint r0 = at + uint(y0) * pitch, r1 = at + uint(y1) * pitch;
  const int top = (src_byte(r0 + uint(x0 * channels + k)) * (256 - wx) + src_byte(r0 + uint(x1 * channels + k)) * wx) >> 8;
  const int bottom = (src_byte(r1 + uint(x0 * channels + k)) * (256 - wx) + src_byte(r1 + uint(x1 * channels + k)) * wx) >> 8;
  return (top * (256 - wy) + bottom * wy) >> 8;
}

// A mask's coverage at an output point, 0..255 (draw_text's `coverage`).
float mask_cover(float ox, float oy) {
  vec2 p = source(ox, oy);
  precise float e = P(8u) != 0u ? edge(p) : 1.0;
  if (e <= 0.0)
    return 0.0;
  const int w = int(P(2u)), h = int(P(3u));
  precise float u = p.x - 0.5, v = p.y - 0.5;
  const int x0 = int(floor(u)), y0 = int(floor(v));
  precise float fx = u - float(x0), fy = v - float(y0);
  float at[4];
  for (int j = 0; j < 4; ++j) {
    const int x = x0 + (j & 1), y = y0 + (j >> 1);
    at[j] = (x < 0 || y < 0 || x >= w || y >= h) ? 0.0 : float(src_byte(P(5u) + uint(y) * P(4u) + uint(x)));
  }
  precise float top = at[0] * (1.0 - fx) + at[1] * fx;
  precise float bottom = at[2] * (1.0 - fx) + at[3] * fx;
  precise float c = (top * (1.0 - fy) + bottom * fy) * e;
  return c;
}

void main() {
  const uint word = pc.x0 / 4u + gl_GlobalInvocationID.x;
  const uint y = pc.y0 + gl_GlobalInvocationID.y;
  if (word * 4u >= pc.x1 || y >= pc.y1)
    return;
  const bool mask = P(0u) == 1u;
  const int alpha = int(P(1u));
  const uint fat = (pc.frame_at + y * pc.stride) / 4u + word;
  uint out_word = frame[fat];
  // A U/V pair is two bytes: both are worked out once, at the pair's centre.
  for (uint q = 0u; q < 4u; q += (pc.chroma != 0u ? 2u : 1u)) {
    const uint b = word * 4u + q;
    if (b < pc.x0 || b >= pc.x1)
      continue;
    const float ox = pc.chroma != 0u ? float(b) + 1.0 : float(b) + 0.5; // the pair (b / 2) covers luma pixels b and b + 1
    const float oy = pc.chroma != 0u ? float(2u * y) + 1.0 : float(y) + 0.5;
    int a;
    if (mask) {
      precise float c = mask_cover(ox, oy);
      precise float scaled = c * float(alpha) * 0.00390625 + 0.5;
      a = int(scaled);
    } else {
      vec2 p = source(ox, oy);
      precise float opacity = edge(p);
      if (opacity <= 0.0)
        continue;
      if (P(7u) != 0xFFFFFFFFu) {
        precise float o = float(sample_plane(P(7u), P(4u), int(P(2u)), int(P(3u)), 1, 0, p.x - 0.5, p.y - 0.5)) * uintBitsToFloat(0x3B808081u);
        opacity = opacity * o;
      }
      precise float scaled = float(alpha) * opacity + 0.5;
      a = int(scaled);
    }
    if (a <= 0)
      continue;
    for (uint k = 0u; k < (pc.chroma != 0u ? 2u : 1u); ++k) {
      int s;
      if (mask) {
        s = int((P(9u) >> ((pc.chroma != 0u ? 1u + k : 0u) * 8u)) & 0xFFu);
      } else if (pc.chroma == 0u) {
        vec2 p = source(ox, oy);
        s = sample_plane(P(5u), P(4u), int(P(2u)), int(P(3u)), 1, 0, p.x - 0.5, p.y - 0.5);
      } else {
        vec2 p = source(ox, oy);
        precise float cu = p.x * 0.5 - 0.5, cv = p.y * 0.5 - 0.5;
        s = sample_plane(P(6u), P(4u), int(P(2u)) / 2, int(P(3u)) / 2, 2, int(k), cu, cv);
      }
      const uint shift = (q + k) * 8u;
      const int d = int((out_word >> shift) & 0xFFu);
      const uint v = uint((s * a + d * (256 - a)) >> 8);
      out_word = (out_word & ~(0xFFu << shift)) | (v << shift);
    }
  }
  frame[fat] = out_word;
}
