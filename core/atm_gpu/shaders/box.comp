#version 450
// One vertical box-blur pass of a packed picture plane (the horizontal ones are box_rows.comp), in integer arithmetic so
// it gives the same bytes as the CPU's box_vertical: each output is (sum of the 2r + 1 samples around it + w / 2) / w,
// edges clamped.
//
// The buffers are read and written as 32-bit words (4 bytes of the picture each); rows are padded to whole words. An
// invocation takes one word column (4 byte columns) over a stretch of `seg` rows and slides a running sum down it, so the
// cost per sample does not grow with the radius; neighbouring invocations read neighbouring words of a row, together,
// which keeps the pass at the memory's own speed.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint dst[]; };

layout(push_constant) uniform Pass {
  uint offset;   // the plane's first byte (a multiple of 4)
  uint rows;     // rows of the plane
  uint stride;   // bytes from one row to the next (a multiple of 4)
  uint n;        // words across a row
  uint unused;
  int r;         // box radius
  uint seg;      // rows per invocation
  uint vertical; // 1
} pc;

ivec4 unpack(uint word) { return ivec4(word & 0xFFu, (word >> 8) & 0xFFu, (word >> 16) & 0xFFu, word >> 24); }

void main() {
  const int r = pc.r, w = 2 * r + 1;
  const int s0 = int(gl_GlobalInvocationID.y * pc.seg);
  {
    const uint col = gl_GlobalInvocationID.x;
    const int rows = int(pc.rows);
    if (col >= pc.n || s0 >= rows)
      return;
    const int s1 = min(rows, s0 + int(pc.seg));
    const uint first = (pc.offset >> 2) + col, words = pc.stride >> 2;
    ivec4 sum = ivec4(0);
    for (int k = s0 - r; k <= s0 + r; ++k)
      sum += unpack(src[first + uint(clamp(k, 0, rows - 1)) * words]);
    for (int y = s0; y < s1; ++y) {
      const uvec4 v = uvec4((sum + w / 2) / w);
      dst[first + uint(y) * words] = v.x | (v.y << 8) | (v.z << 16) | (v.w << 24);
      sum += unpack(src[first + uint(min(y + r + 1, rows - 1)) * words]) - unpack(src[first + uint(max(y - r, 0)) * words]);
    }
  }
}
