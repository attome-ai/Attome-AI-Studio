{
  "name": "attome",
  "version-string": "0.1.0-dev",
  "description": "Attome engine. Only permissive dependencies (ADR-025).",
  "builtin-baseline": "10541e317a660f4165ba4ac2851ab54a8d4577b1",
  "dependencies": [
    "nlohmann-json",
    "tl-expected",
    "blake3",
    "cli11",
    "catch2",
    "sdl3",
    "stb",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "sdl3-binding",
        "sdl3-renderer-binding"
      ]
    }
  ],
  "features": {
    "ffmpeg": {
      "description": "Portable media backend: LGPL FFmpeg (no GPL parts), Cisco OpenH264 and the NVIDIA / AMD hardware encoders.",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec",
            "avformat",
            "swresample",
            "swscale",
            "openh264",
            {
              "name": "nvcodec",
              "platform": "(windows | linux) & x64"
            },
            {
              "name": "amf",
              "platform": "windows | linux"
            }
          ]
        }
      ]
    },
    "portable-text": {
      "description": "Portable text: FreeType rasterizing, HarfBuzz shaping and SheenBidi for right-to-left text.",
      "dependencies": [
        {
          "name": "freetype",
          "default-features": false,
          "features": [
            "zlib"
          ]
        },
        {
          "name": "harfbuzz",
          "default-features": false,
          "features": [
            "freetype"
          ]
        },
        "sheenbidi"
      ]
    }
  }
}
